{
  "name": "certificate-generator",
  "version": "2.0.0",
  "private": true,
  "description": "Private, browser-based bulk certificate generation from PDF templates and spreadsheets.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "predev": "node scripts/copy-pdf-assets.mjs",
    "build": "node scripts/copy-pdf-assets.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "jszip": "^3.10.2",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "read-excel-file": "^9.3.12",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "vite": "^8.3.4"
  }
}
